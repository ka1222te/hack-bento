# ===== HackBento 環境設定テンプレート =====
# cp .env.example .env  してから値を埋めてください
# ネットワーク関連（BRIDGE_NAME・FC_GUEST_GATEWAY・IP_POOL_*等）は
# 通常 setup.sh が対話式に生成するため、手動編集は基本不要です。

# --- アプリ ---
APP_TITLE=HackBento

# --- サーバ ---
DOMAIN=localhost
SCHEME=http
PORT=8000

# --- タイムアウト・制限 ---
DEFAULT_TIMEOUT_MINUTES=60
# VM起動・延長時に選択できるタイムアウト（分）の候補（カンマ区切り）。0は無制限を表す。
# 負の値や数値でない値は無視される。空になった場合は既定値にフォールバックする。
TIMEOUT_MINUTES_OPTIONS=15,30,45,60,75,90,105,120,0
TIMEOUT_WARNING_MINUTES=10
MAX_ENVS_PER_USER=2
MAX_ENVS_TOTAL=20
VM_CPU_LIMIT=1
VM_MEMORY_LIMIT_MB=1024
VM_DISK_LIMIT_GB=10
VM_PIDS_LIMIT=256
UPLOAD_IMAGE_MAX_MB=6144
UPLOAD_README_MAX_MB=10

# --- セキュリティ ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- DB ---
DATABASE_URL=sqlite+aiosqlite:////data/db/hackbento.db

# --- LDAP ---
LDAP_ENABLED=false
LDAP_URI="ldap://example.com:389"
LDAP_TOP_DOMAIN="dc=example,dc=com"
LDAP_USER_FILTER="(uid={username})"
LDAP_OU_USER="people"
LDAP_OU_GROUP="groups"

# --- Google OAuth2 ---
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
OAUTH_ALLOWED_DOMAINS=

# --- ネットワーク (Firecracker microVM + bridge。通常は setup.sh が自動生成) ---
## TAP を接続するホストブリッジ名（setup.sh で作成したもの）
BRIDGE_NAME=vmbr-hackbento
## ゲストにルーティングするゲートウェイ（ホストのブリッジIP）
FC_GUEST_GATEWAY=192.168.180.1
## ゲストに設定する DNS サーバ（カンマ区切りで複数指定可能）
FC_GUEST_DNS=8.8.8.8,8.8.4.4
IP_POOL_START=192.168.181.200
IP_POOL_END=192.168.181.230

# --- Attack Machine (Kali Linux + XFCE + TigerVNC) ---
## true にすると初回起動時にKali rootfsを自動構築する（ビルドに30分以上かかる場合があります）
ATTACK_MACHINE_ENABLED=true
ATTACK_MACHINE_CPU_LIMIT=2
ATTACK_MACHINE_MEMORY_LIMIT_MB=2048
## Attack Machineのタイムアウト（分）。0は無制限を表す。
## 負の値や数値でない値は無視され、既定値（60分）にフォールバックする。
ATTACK_MACHINE_TIMEOUT_MINUTES=60

# --- docker-base builder ---
## orchestrator コンテナから見た docker-base-builder への接続先。
## 両コンテナとも network_mode: host 構成のため通常は変更不要。
DOCKER_BASE_BUILDER_URL=http://127.0.0.1:8300

# --- Guacamole (Attack Machine の GUI アクセスに使用) ---
## openssl rand -hex 16  (AES-128) で生成。SECRET_KEY とは別の鍵。
GUACAMOLE_JSON_SECRET_KEY=changeme-generate-with-openssl-rand-hex-16
## orchestrator コンテナから見た Guacamole (Tomcat) への接続先。通常は変更不要。
GUACAMOLE_INTERNAL_URL=http://127.0.0.1:8080/guacamole
## ブラウザから見た公開パス（main.py がこのパス配下をリバースプロキシする）。通常は変更不要。
GUACAMOLE_PUBLIC_PATH=/guacamole
